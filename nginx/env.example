# ==============================================================================
# 可选覆盖：docker-compose.yml 里每个变量都写成 ${VAR:-默认值}，
# 想改哪个就在 .env 里写哪个。下面是全部可用的变量及默认值。
# （.env 已在 .gitignore 中，不会被提交。）
# ==============================================================================

# ⚠️ 不要把 GALLERY_PASSWORD_HASH 放这里 ⚠️
# compose 会对 .env 做变量插值，bcrypt 哈希里的 $ 会被当成变量引用而吞掉：
#   $2y$12$abc...  →  $$2y$$12      （尾部被吃掉 → 密码对也登不进去）
# 密码请放到 secrets/password_hash.txt，见 docker-compose.yml 顶部说明。

# ---- 宿主路径（挂载用）----
# GALLERY_CODE_DIR=/opt/camera/web-ui
# GALLERY_CAPTURE_HOST_DIR=/opt/camera/capture
# GALLERY_STATUS_HOST_FILE=/opt/camera/status.json
# GALLERY_HTTP_PORT=28080

# ---- 照片目录与传输方式 ----
# GALLERY_CAPTURES_DIR=/var/www/capture
# GALLERY_IMAGE_MODE=proxy
# GALLERY_WEB_PATH=/captures

# ---- 缩略图与缓存 ----
# GALLERY_CACHE_DIR=/tmp/gallery-cache
# GALLERY_CACHE_TTL=3600
# GALLERY_THUMB_MAX_DIMENSION=420
# GALLERY_THUMB_QUALITY=78

# ---- 会话与登录 ----
# GALLERY_SESSION_NAME=PhotoGallerySession
# GALLERY_SESSION_IDLE_TIMEOUT=1800
# GALLERY_SESSION_ABSOLUTE_TIMEOUT=43200
# GALLERY_BIND_SESSION_TO_IP=false
# GALLERY_LOGIN_MAX_ATTEMPTS=5
# GALLERY_LOGIN_LOCKOUT_SECONDS=300

# ---- 接口限流 ----
# GALLERY_API_RATE_LIMIT=240
# GALLERY_API_RATE_WINDOW=60
# GALLERY_OPS_REFRESH_RATE_LIMIT=6

# ---- 前端默认行为 ----
# GALLERY_DEFAULT_VIEW=gallery
# GALLERY_SLIDESHOW_SPEED=1
# GALLERY_DOWNLOAD_ENABLED=true
# GALLERY_THEME_MODE=dark
# GALLERY_THEME_ACCENT=blue

# ---- 实时监控（毫秒）----
# GALLERY_MONITOR_INITIAL_INTERVAL=1500
# GALLERY_MONITOR_MIN_INTERVAL=1000
# GALLERY_MONITOR_MAX_INTERVAL=8000

# ---- 运维面板 ----
# GALLERY_HEALTH_FILE=/var/www/status.json
# GALLERY_HEALTH_STALE_SECONDS=900
# GALLERY_DISK_WARN_PERCENT=85
# GALLERY_STATS_RECENT_DAYS=31
# GALLERY_STATS_CACHE_TTL=3600

# ---- 安全 / 环境 ----
# GALLERY_TRUST_PROXY=false
# GALLERY_TIMEZONE=Asia/Shanghai

# ---- 密码（二选一，不要用 .env 直接传哈希）----
# 方式 A（推荐）：文件，见 docker-compose.yml 的 secrets 说明
# GALLERY_PASSWORD_HASH_FILE=/run/secrets/gallery_password_hash
# 方式 B：写进 web-ui/config.php 的 password_hash
